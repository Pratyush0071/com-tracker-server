# Standalone API server port
PORT="5000"

# MongoDB Atlas or self-hosted MongoDB URI (falls back to in-memory replSet in dev if empty)
MONGODB_URI=""

# Strong random secret for signing JWT auth tokens
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins allowed by CORS (e.g. http://localhost:5173,https://your-frontend.vercel.app)
CORS_ORIGIN="http://localhost:5173"

# Initial Admin Seed Configuration
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@lakshyasales.local"
ADMIN_PASSWORD="ChangeMe@12345"
COMPANY_NAME="Commission Tracker"
